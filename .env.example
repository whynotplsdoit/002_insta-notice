# 굿즈레이더 .env 예시 (값은 비워 둠, 진짜 값은 .env 에만, .env 는 GitHub 에 올리지 않음)
# 이 파일을 .env 로 복사한 뒤, 아래 "다시 받는 곳"에서 값을 찾아 채우세요.
# 비밀번호 관리자(1Password·Bitwarden 등)의 보안 메모에 .env 전체를 백업해 두면 가장 빠릅니다.

# Supabase 주소 — Supabase 대시보드 → goods-feed → Project Settings → Data API → Project URL
SUPABASE_URL=

# 공개 키(sb_publishable_…) — Project Settings → API Keys → Publishable key
SUPABASE_PUBLISHABLE_KEY=

# 비밀 키(sb_secret_…) — Project Settings → API Keys → Secret keys (새로 만들면 예전 키는 지워도 됨)
# Vercel 환경 변수 SUPABASE_SECRET_KEY(슬랙 봇용)에도 같은 값
SUPABASE_SECRET_KEY=

# 카카오 REST API 키 — developers.kakao.com → 내 애플리케이션 → WHYNOT → 앱 키
# Supabase 금고(Vault) kakao_rest_api_key 에도 같은 값. 값을 넣은 뒤 PC에서 npm run kakao:login 한 번
KAKAO_REST_API_KEY=

# 슬랙 알림 웹후크 — api.slack.com/apps → goods-radar → Incoming Webhooks (채널: whynot_굿즈레이더)
# Supabase 금고(Vault) slack_webhook_url 에도 같은 값
SLACK_WEBHOOK_URL=

# 카카오맵 JavaScript 키 — developers.kakao.com → WHYNOT → 앱 키 → JavaScript 키
# Vercel 환경 변수 VITE_KAKAO_JS_KEY(Config 타입)에도 같은 값
VITE_KAKAO_JS_KEY=
